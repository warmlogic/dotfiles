# Work-machine-only entries. Combine with Brewfile.common.
# Install via:
# $ brew bundle --file=Brewfile.work

cask_args appdir: '/Applications'

brew 'k9s' # Kubernetes CLI https://k9scli.io
brew 'rbenv'
brew 'ruby-install'

cask 'loom'
cask 'postgres-unofficial' # https://postgresapp.com/documentation/cli-tools.html
# for psql, add to ~/.bash_profile: PATH="/Applications/Postgres.app/Contents/Versions/latest/bin:$PATH"
cask 'postico'
cask 'postman'
