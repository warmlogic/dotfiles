# Entries shared between personal and work machines.
# Install via:
# $ brew bundle --file=Brewfile.common

# This puts the applications in the correct folder
cask_args appdir: '/Applications'

# Use GNU instead of BSD commands
brew 'coreutils'
brew 'findutils'
brew 'gawk'
brew 'gnu-sed'
brew 'gnu-tar'
brew 'gnu-which'
brew 'grep'
brew 'gzip'
brew 'ripgrep'
brew 'watch'
brew 'wget'

brew 'actionlint' # GitHub Actions workflow linter https://rhysd.github.io/actionlint/
brew 'awscli'
brew 'bash' # Newest version of Bash
brew 'bash-completion@2' # Bash tab completion for Bash
brew 'beads' # `bd` issue tracker for coding agents https://github.com/gastownhall/beads
brew 'bun' # JavaScript runtime; gstack (05-agents.sh) builds and runs its tools with it
brew 'emacs'
brew 'file-formula' # guess file type
brew 'gh' # https://cli.github.com
brew 'ghostscript' # `gs`, used by the mergepdf alias
brew 'graphviz' # for python tree model plotting
brew 'htop' # Better top command
brew 'imagemagick'
brew 'less'
brew 'make'
brew 'markdownlint-cli2' # markdown linter with auto-fix
brew 'node'
brew 'prettier' # code/markdown formatter
brew 'rsync'
brew 'tmux'
brew 'tree' # Visualize directory structure
brew 'unzip'
brew 'vim'
brew 'zsh'

# Git and some surrounds
brew 'git'
brew 'git-lfs'
brew 'git-extras'

# Jump to frequently used folders: `z <part of name>` https://github.com/ajeetdsouza/zoxide
brew 'zoxide'

# Support for Mac App Store apps https://github.com/mas-cli/mas
brew 'mas'

# Mole: deep clean/optimize https://github.com/tw93/Mole
brew 'mole'

# Install additional applications

cask '1password' # latest
cask 'chatgpt'
cask 'claude'
cask 'cursor'
cask 'docker-desktop'
cask 'ghostty'
cask 'google-chrome'
cask 'itsycal'
cask 'monitorcontrol'
cask 'notunes'
cask 'slack'
cask 'spotify'
cask 'visual-studio-code'
cask 'whatcable'
cask 'zoom'

# Install QuickLook plugins https://github.com/sindresorhus/quick-look-plugins
cask 'betterzip' # for its Quick Look preview of archive contents
cask 'syntax-highlight' # open "Syntax Highlight.app" after installing

# Install Fonts
cask 'font-aporetic'
cask 'font-fira-code'
cask 'font-iosevka'

# Install apps via Mac App Store
mas 'Amphetamine', id: 937984704
mas 'Deliveries', id: 290986013
mas 'Keynote', id: 361285480
mas 'Little Snitch Mini', id: 1629008763
mas 'Numbers', id: 361304891
mas 'One Thing', id: 1604176982
mas 'Pages', id: 361309726
mas 'The Unarchiver', id: 425424353

# Install Safari extensions via Mac App Store
mas 'Wipr 2', id: 1662217862
