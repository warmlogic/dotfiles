# Entries shared between personal and work machines.
# Install via:
# $ brew bundle --file=Brewfile.common

# This puts the applications in the correct folder
cask_args appdir: '/Applications'

# Use GNU instead of BSD commands
# the with-default-names uses normal name, rather than g-prefixed
brew 'coreutils'
brew 'findutils'
brew 'gawk'
brew 'gnu-indent'
brew 'gnu-sed'
brew 'gnu-tar'
brew 'gnu-which'
brew 'gnutls'
brew 'gpatch'
brew 'grep'
brew 'gzip'
brew 'readline'
brew 'watch'
brew 'wdiff'
brew 'wget'

brew 'autojump'
brew 'awscli'
brew 'bash' # Newest version of Bash
brew 'bash-completion@2' # Bash tab completion for Bash
brew 'cheat' # Simple cheat-sheets; install and run `$ cheat tar`
brew 'emacs'
brew 'file-formula' # guess file type
brew 'gh' # https://cli.github.com
brew 'graphviz' # for python tree model plotting
brew 'htop' # Better top command
brew 'imagemagick'
brew 'less'
brew 'make'
brew 'node'
brew 'rename'
brew 'rsync'
brew 'screen'
brew 'tmux'
brew 'tree' # Visualize directory structure
brew 'unzip'
brew 'uv' # Python version/tool manager, see 04-python.sh
brew 'vim'
brew 'zsh'

# Git and some surrounds
brew 'git'
brew 'git-lfs'
brew 'git-extras'

# Easy cd https://github.com/rupa/z
brew 'z'

# Mac Swiss Army Knife https://github.com/rgcr/m-cli
brew 'm-cli'

# Support for Mac App Store apps https://github.com/mas-cli/mas
brew 'mas'

# Mole: deep clean/optimize https://github.com/tw93/Mole
brew 'mole'

# Install additional applications

cask '1password' # latest
cask 'cursor'
cask 'docker'
cask 'ghostty'
cask 'google-chrome'
cask 'itsycal'
cask 'jupyter-notebook-viewer'
cask 'monitorcontrol'
cask 'notunes'
cask 'slack'
cask 'spotify'
cask 'visual-studio-code'
cask 'whatcable'
cask 'zoom'

# Install QuickLook plugins https://github.com/sindresorhus/quick-look-plugins
cask 'betterzip' # preview archives
cask 'syntax-highlight', args: { no_quarantine: true } # open "Syntax Highlight.app" after installing

# Install Fonts
cask 'font-fira-code'
cask 'font-source-code-pro'
cask 'font-source-sans-pro'

# Install apps via Mac App Store
mas 'Amphetamine', id: 937984704
mas 'Deliveries', id: 290986013
mas 'Keynote', id: 409183694
mas 'Little Snitch Mini', id: 1629008763
mas 'Numbers', id: 409203825
mas 'Pages', id: 409201541
mas 'The Unarchiver', id: 425424353

# Install Safari extensions via Mac App Store
mas '1Password for Safari', id: 1569813296
mas 'StopTheMadness', id: 1376402589
mas 'Wipr', id: 1320666476
