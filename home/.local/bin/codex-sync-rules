#!/usr/bin/env python3
"""Mirror Claude Code's Bash ask/deny rules into Codex execpolicy rules.

Writes ~/.codex/rules/claude-mirror.rules from ~/.claude/settings.json:
  permissions.deny  Bash(<cmd> *) / Bash(<cmd>) -> prefix_rule(decision="forbidden")
  permissions.ask   Bash(<cmd> *) / Bash(<cmd>) -> prefix_rule(decision="prompt")

Claude's allow rules are deliberately NOT mirrored: in Codex an "allow" rule runs the
command outside the sandbox, so mirroring broad allows (git *, curl *, docker *) would
loosen Codex, not match it. Everything not ruled stays sandboxed (workspace-write).
Patterns Codex prefix rules cannot express (a wildcard mid-command, globs in a token,
a bare `Bash` that covers every command) are skipped, listed on stderr and as comments
in the generated file.

Re-run this after editing Claude's ask/deny rules or after `dfp pull`;
05-agents.sh runs it on a new machine. The file is rewritten only when it changes.
`--check` prints nothing, writes nothing, and exits 1 if the file is missing or stale.
"""
from __future__ import annotations  # list[str] | None on macOS's Python 3.9

import json
import os
import shlex
import sys
from pathlib import Path

SETTINGS = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / "settings.json"
OUT = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")) / "rules" / "claude-mirror.rules"
DECISIONS = {"deny": "forbidden", "ask": "prompt"}


def prefix(rule: str) -> list[str] | None:
    if not (rule.startswith("Bash(") and rule.endswith(")")):
        return None
    body = rule[5:-1].strip()
    if body.endswith(" *"):
        body = body[:-2]
    try:
        tokens = shlex.split(body)
    except ValueError:
        return None
    if not tokens or any(ch in t for t in tokens for ch in "*?["):
        return None
    return tokens


def main(check: bool) -> int:
    perms = json.loads(SETTINGS.read_text()).get("permissions", {})
    lines, skipped = [f"# Generated by {Path(__file__).name} from {SETTINGS}; do not edit by hand."], []
    for key, decision in DECISIONS.items():
        for rule in perms.get(key, []):
            p = prefix(rule)
            if p is None:
                if rule == "Bash" or rule.startswith("Bash("):
                    skipped.append(f"{key}: {rule}")
                continue
            lines.append(f"prefix_rule(pattern={json.dumps(p)}, decision=\"{decision}\")")
    n_rules = len(lines) - 1
    if not check:
        for s in skipped:
            print(f"skipped (not a prefix): {s}", file=sys.stderr)
    lines += [f"# skipped (not a prefix): {s}" for s in skipped]
    text = "\n".join(lines) + "\n"
    is_current = OUT.exists() and OUT.read_text() == text
    if check or is_current:
        return 0 if is_current else 1
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(text)
    print(f"wrote {n_rules} rules to {OUT}")
    return 0


if __name__ == "__main__":
    if sys.argv[1:] not in ([], ["--check"]):
        print("usage: codex-sync-rules [--check]", file=sys.stderr)
        sys.exit(2)
    sys.exit(main(sys.argv[1:] == ["--check"]))
