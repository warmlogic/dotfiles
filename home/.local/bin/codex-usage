#!/usr/bin/env python3
"""codex-usage [status|reset] -- Codex plan usage and reset credits via `codex app-server` (stdio JSON-RPC).

`status --hint` prints one line in Claude Code hintline's format: `7d: 23% ↺3d13h · 1 reset credit(s)`."""
import argparse, glob, json, os, subprocess, sys, threading, time, uuid
from datetime import datetime

# Per app-server reply; a status makes two (initialize, read), and the reply takes
# ~0.5 s, so a hung server still leaves the SessionStart hook's 15 s for the fallback.
TIMEOUT = 5

def rpc(calls):
    """Run [(method, params)] against a fresh app-server; return results in order."""
    p = subprocess.Popen(["codex", "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True)
    out = {}
    def send(m):
        p.stdin.write(json.dumps(m) + "\n"); p.stdin.flush()
    def reader():
        for line in p.stdout:
            try: m = json.loads(line)
            except ValueError: continue
            if "id" in m and ("result" in m or "error" in m): out[m["id"]] = m
    threading.Thread(target=reader, daemon=True).start()
    try:
        send({"id": 0, "method": "initialize", "params": {"clientInfo": {"name": "codex-usage", "title": None, "version": "1"}}})
        wait(out, 0)
        send({"method": "initialized"})
        res = []
        for i, (method, params) in enumerate(calls, 1):
            send({"id": i, "method": method, "params": params})
            m = wait(out, i)
            if "error" in m: raise RuntimeError(f"{method}: {m['error'].get('message', m['error'])}")
            res.append(m["result"])
        return res
    finally:
        try: p.stdin.close()
        except OSError: pass
        try: p.wait(3)
        except subprocess.TimeoutExpired: p.kill(); p.wait()

def wait(out, i):
    end = time.time() + TIMEOUT
    while i not in out:
        if time.time() > end: raise RuntimeError(f"timeout after {TIMEOUT}s waiting for app-server")
        time.sleep(0.05)
    if "error" in out[i] and i == 0: raise RuntimeError(f"initialize: {out[i]['error']}")
    return out[i]

def ts(t):
    return datetime.fromtimestamp(t).astimezone().strftime("%a %b %d %H:%M %Z") if t else "n/a"

def dur(mins):
    """Minutes as the largest whole units: 10080 -> 7d, 300 -> 5h, 9862 -> 6d20h22m."""
    d, rest = divmod(mins, 1440); h, m = divmod(rest, 60)
    return "".join(f"{n}{u}" for n, u in ((d, "d"), (h, "h"), (m, "m")) if n) or "0m"

def countdown(mins):
    """Time until a reset, as Claude Code's hintline draws it: 3d04h, 1h44m, 41m."""
    d, rest = divmod(mins, 1440); h, m = divmod(rest, 60)
    if d: return f"{d}d{h:02d}h"
    return f"{h}h{m:02d}m" if h else f"{m}m"

def rel(t):
    if not t: return ""
    return f"in {countdown(max(int(t - time.time()), 0) // 60)}"

def credits(r):
    cs = [c for c in (r.get("rateLimitResetCredits") or {}).get("credits") or [] if c.get("status") == "available"]
    return sorted(cs, key=lambda c: c.get("expiresAt") or float("inf"))

def windows(r):
    """Each reported window: (limit id, snapshot, primary|secondary, window)."""
    snaps = r.get("rateLimitsByLimitId") or {"codex": r["rateLimits"]}
    return [(lid, s, n, w) for lid, s in snaps.items() for n in ("primary", "secondary") if (w := (s or {}).get(n))]

def is_exhausted(r):
    return r.get("ordinaryUsageAllowed") is False or any((w.get("usedPercent") or 0) >= 100 for *_, w in windows(r))

def summarize(r):
    """Print summary; return True if usage is exhausted."""
    exhausted = is_exhausted(r)
    for lid, s, name, w in windows(r):
        mins = w.get("windowDurationMins")
        print(f"{s.get('limitName') or lid} {name} ({dur(mins) if mins else '?'} window): {w['usedPercent']}% used, resets {ts(w.get('resetsAt'))} ({rel(w.get('resetsAt'))})")
    print(f"ordinary usage allowed: {r.get('ordinaryUsageAllowed')}")
    cs = credits(r)
    print(f"reset credits available: {(r.get('rateLimitResetCredits') or {}).get('availableCount', 0)}")
    for c in cs:
        print(f"  {c['id']}  {c['resetType']}  {c.get('title') or ''}  expires {ts(c.get('expiresAt'))}")
    return exhausted

def hint_part(name, mins, pct, resets_at):
    """One window as hintline draws it: `7d: 23% ↺3d13h`, the limit's name first unless it's `codex`."""
    label = dur(mins) if mins else "?"
    if name and name != "codex": label = f"{name} {label}"
    remaining = int(resets_at - time.time()) // 60 if resets_at else 0
    return f"{label}: {int(pct + 0.5)}%" + (f" ↺{countdown(remaining)}" if remaining > 0 else "")

def hint(r):
    """Print the hint line; return True if usage is exhausted."""
    parts = [hint_part(s.get("limitName") or lid, w.get("windowDurationMins"), w["usedPercent"], w.get("resetsAt"))
             for lid, s, _, w in windows(r) if w.get("usedPercent") is not None]
    n = (r.get("rateLimitResetCredits") or {}).get("availableCount", 0)
    print(" · ".join(parts + [f"{n} reset credit(s)"]))
    return is_exhausted(r)

def rollout_snapshot():
    """The newest rate-limit snapshot a Codex session wrote: (file name, rate_limits)."""
    files = sorted(glob.glob(os.path.expanduser("~/.codex/sessions/*/*/*/rollout-*.jsonl")))
    for f in reversed(files):
        for line in reversed(open(f).read().splitlines()):
            if '"rate_limits"' in line:
                rl = (json.loads(line).get("payload") or {}).get("rate_limits")
                if rl and rl.get("primary"): return os.path.basename(f), rl
    raise RuntimeError("no rollout snapshot found")

def rollout_fallback(as_hint=False):
    f, rl = rollout_snapshot()
    ws = [(n, w) for n in ("primary", "secondary") if (w := rl.get(n)) and w.get("used_percent") is not None]
    if as_hint:
        print(" · ".join(hint_part(rl.get("limit_name") or rl.get("limit_id"), w.get("window_minutes"), w["used_percent"], w.get("resets_at"))
                         for _, w in ws) + " (stale snapshot)")
    else:
        print(f"(fallback: rollout snapshot {f}; may be stale)")
        for n, w in ws: print(f"{n}: {w['used_percent']}% used, resets {ts(w.get('resets_at'))}")
    return max((w["used_percent"] for _, w in ws), default=0) >= 100

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", nargs="?", default="status", choices=["status", "reset"])
    fmt = ap.add_mutually_exclusive_group()
    fmt.add_argument("--json", action="store_true")
    fmt.add_argument("--hint", action="store_true", help="status as one hintline-style line")
    ap.add_argument("--yes", action="store_true")
    ap.add_argument("--id")
    a = ap.parse_args()
    try:
        if a.cmd == "status":
            try:
                (r,) = rpc([("account/rateLimits/read", None)])
            except Exception as e:
                if a.json: raise
                print(f"app-server failed ({e})", file=sys.stderr)
                return 3 if rollout_fallback(a.hint) else 0
            if a.json: print(json.dumps(r, indent=2)); return 0
            if a.hint: return 3 if hint(r) else 0
            return 3 if summarize(r) else 0
        if not a.yes:
            raise RuntimeError("refusing to consume a reset credit without --yes")
        (r,) = rpc([("account/rateLimits/read", None)])
        cs = credits(r)
        cid = a.id or (cs[0]["id"] if cs else None)
        if not cid: raise RuntimeError("no available reset credit")
        (res,) = rpc([("account/rateLimitResetCredit/consume", {"creditId": cid, "idempotencyKey": str(uuid.uuid4())})])
        print(f"consumed {cid}: outcome={res['outcome']}")
        (r,) = rpc([("account/rateLimits/read", None)])
        summarize(r)
        return 0
    except Exception as e:
        print(f"codex-usage: {e}", file=sys.stderr)
        return 1

sys.exit(main())
