theme = Dracula
font-family = Fira Code Retina
font-size = 13
font-thicken = true

# Period included, but possibly remove for better URL selection
selection-word-chars = " \t'\"│`|:;,.()[]{}<>!@#$%^&*_+?"

copy-on-select = clipboard

window-padding-x/y = 8
window-padding-balance = true
window-save-state = always
macos-titlebar-style = tabs
background-opacity = 0.95
background-blur = 20

# Quick terminal (drop-down, like iTerm hotkey window)
keybind = global:cmd+grave_accent=toggle_quick_terminal

# https://github.com/ghostty-org/ghostty/discussions/11530
keybind = super+v=paste_from_clipboard

