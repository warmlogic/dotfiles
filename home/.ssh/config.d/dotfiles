# UseKeychain is Apple-only; other OpenSSH builds would reject it
IgnoreUnknown UseKeychain

# Keep SSH key passphrases in the macOS Keychain, so you type each one only once.
# No IdentityFile: naming one makes ssh skip its defaults (id_rsa, id_ed25519, ...).
Host *
  UseKeychain yes
  AddKeysToAgent yes
