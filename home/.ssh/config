# Keep SSH key passphrases in the macOS Keychain, so you type each one only once
Host *
  UseKeychain yes
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519

# GitHub over port 443, for networks that block ssh's port 22 (airplane, hotel,
# some offices). Same server keys, so reuse the github.com known_hosts entry.
Host github.com
  Hostname ssh.github.com
  Port 443
  User git
  HostKeyAlias github.com
