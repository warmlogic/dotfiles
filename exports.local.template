# ~/.exports.local: personal and machine-specific env vars. Not in the dotfiles
# repo, never overwritten by 01-bootstrap.sh. Sourced right after ~/.exports, so
# anything here overrides it. Uncomment and fill in what this machine needs.

# Extra PATH entries
# export PATH="$HOME/bin:$PATH"

# AWS via Google SAML: aws-setup-gsts and aws-login-chrome both read the
# SAML app's IDs, the idpid= and spid= values in its SSO URL
# export AWS_GOOGLE_IDP_ID=""
# export AWS_GOOGLE_SP_ID=""
# export AWS_GSTS_ROLE_ARN=""   # aws-setup-gsts: only if you can assume several roles
# export AWS_EKS_CONTEXT_NAMES="my_cluster_prod=prod"   # aws-setup-ecr-eks: short kubectl context names
# export AWS_GOOGLE_SAML_ACCOUNT_EMAIL=""   # aws-login-chrome: Chrome profile signed in as this account is used
# export AWS_GOOGLE_SAML_DOWNLOAD_FILE="$HOME/Downloads/credentials"   # aws-login-chrome

# GitHub MCP for Claude Code via OAuth (claude-setup-github-mcp): your OAuth
# app's client ID; the client secret stays in 1Password
# export GITHUB_MCP_CLIENT_ID=""
